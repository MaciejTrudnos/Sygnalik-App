# Sygnalik local configuration
# Copy this file to .env in the project root and fill in your real values:
#   copy .env.example .env
# .env is gitignored - never commit it.

# Identifies your app to OpenStreetMap (required by Nominatim usage policy)
NOMINATIM_USER_AGENT=Sygnalik (contact@example.com)

# Your unique device ID from the Traccar panel
TRACCAR_DEVICE_ID=your-traccar-device-id

# The address of your Traccar instance
TRACCAR_HOST=http://demo3.traccar.org:5055

# The address of the Sygnalik Warning Gateway instance
WARNING_GATEWAY_HOST=http://sygnalik-warning-gateway:5223

# API key used to authorize requests to the Sygnalik Warning Gateway
WARNING_GATEWAY_API_KEY=MY_SECRET_KEY_123

# The address of your GraphHopper routing server (set to override the hardcoded default)
GRAPHHOPPER_HOST=http://graphhopper.example.com:8989
